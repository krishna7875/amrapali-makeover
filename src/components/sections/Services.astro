---
import { getTranslations, type Locale } from '../../utils/i18n';
import business, { buildWhatsAppUrl } from '../../utils/business';
import { Sparkles, MapPin, CheckCircle2, ShieldCheck } from 'lucide-react';
import { WhatsAppIcon } from '../ui/Icons';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const currentLang = (lang as Locale) || 'en';
const t = getTranslations(currentLang);

interface ServiceConfig {
  key: 'bridal' | 'haldi' | 'engagement' | 'party';
  imageSrc: string;
}

const servicesList: ServiceConfig[] = [
  {
    key: 'bridal',
    imageSrc: '/images/services/service-bridal-placeholder.svg',
  },
  {
    key: 'haldi',
    imageSrc: '/images/services/service-haldi-placeholder.svg',
  },
  {
    key: 'engagement',
    imageSrc: '/images/services/service-engagement-placeholder.svg',
  },
  {
    key: 'party',
    imageSrc: '/images/services/service-party-placeholder.svg',
  },
];
---

<section
  id="services"
  aria-labelledby="services-title"
  class="relative overflow-hidden bg-[#FBF8F4] py-16 sm:py-20 lg:py-28 border-b border-[#DFC8C2]/70 section-anchor scroll-mt-5 sm:scroll-mt-8 lg:scroll-mt-0"
>
  <!-- Ambient Subtle Background Blobs -->
  <div
    class="pointer-events-none absolute top-10 -right-32 w-80 h-80 rounded-full bg-[#F2E5E2]/50 blur-3xl"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute bottom-10 -left-32 w-80 h-80 rounded-full bg-[#B99561]/8 blur-3xl"
    aria-hidden="true"
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header (Editorial & Centered/Aligned) -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-[4px] bg-[#F2E5E2] border border-[#DFC8C2] text-[#4B1728] text-xs font-medium tracking-wide mb-4 shadow-xs">
        <Sparkles className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
        <span>{t.servicesSection.eyebrow}</span>
      </div>

      <h2
        id="services-title"
        class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-[#2A1420] leading-[1.18] text-balance mb-4"
      >
        {t.servicesSection.heading}
      </h2>

      <p class="text-base sm:text-lg text-[#524245] leading-relaxed font-normal">
        {t.servicesSection.subheadline}
      </p>
    </div>

    <!-- 4-Column Responsive Grid of Confirmed Services -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-6 lg:gap-7 items-stretch">
      {servicesList.map((svc) => {
        const item = t.servicesSection.items[svc.key];
        const waUrl = buildWhatsAppUrl(business.contact.rawPhone, item.whatsAppMessage);

        return (
          <article
            class="flex flex-col h-full bg-white rounded-[6px] border border-[#DFC8C2] shadow-xs hover:shadow-md hover:border-[#B99561]/60 transition-all duration-300 overflow-hidden group"
          >
            <!-- 4:3 Visual Frame -->
            <div class="relative aspect-4/3 w-full overflow-hidden bg-[#2A1420] border-b border-[#DFC8C2]">
              <img
                src={svc.imageSrc}
                alt={item.imageAlt}
                width="600"
                height="450"
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-500 select-none"
              />

              <!-- Floating Tagline Badge -->
              <div class="absolute top-3 left-3 px-2.5 py-1 rounded-[3px] bg-[#2A1420]/85 backdrop-blur-xs border border-[#B99561]/50 text-[10px] font-semibold uppercase tracking-wider text-[#FBF8F4] shadow-sm">
                {item.tagline}
              </div>
            </div>

            <!-- Card Content Body -->
            <div class="p-5 sm:p-6 flex flex-col flex-1 justify-between space-y-4">
              <div class="space-y-2">
                <h3 class="font-serif text-xl sm:text-2xl font-medium text-[#2A1420] tracking-tight group-hover:text-[#4B1728] transition-colors duration-200">
                  {item.name}
                </h3>
                
                <p class="text-xs sm:text-sm text-[#524245] leading-relaxed">
                  {item.description}
                </p>
              </div>

              <!-- Card Action Area: Price Tag & Service WhatsApp CTA -->
              <div class="pt-4 border-t border-[#DFC8C2]/70 space-y-3">
                <div class="flex items-center justify-between text-xs text-[#74686A]">
                  <span class="inline-flex items-center gap-1 font-medium text-[#4B1728]">
                    <ShieldCheck className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
                    {t.servicesSection.enquiryOnlyTag}
                  </span>
                  <span class="text-[11px] text-[#74686A]">
                    {t.servicesSection.onLocationTag}
                  </span>
                </div>

                <a
                  href={waUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="w-full inline-flex items-center justify-center font-medium transition-all duration-200 cursor-pointer select-none rounded-[4px] bg-[#4B1728] text-[#FBF8F4] hover:bg-[#642037] active:bg-[#37101D] text-xs sm:text-sm px-4 py-2.5 gap-2 uppercase tracking-wider font-semibold shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B99561] focus-visible:ring-offset-2 text-center"
                  aria-label={`${item.enquiryCta} — ${item.name}`}
                >
                  <WhatsAppIcon className="w-4 h-4 shrink-0" aria-hidden="true" />
                  <span>{item.enquiryCta}</span>
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Verified Pricing & On-Location Service Notice Banner -->
    <div class="mt-12 sm:mt-16 p-5 sm:p-6 rounded-[6px] bg-white border border-[#DFC8C2] shadow-xs">
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <MapPin className="w-4 h-4 text-[#B99561] shrink-0" aria-hidden="true" />
            <h4 class="font-serif text-sm sm:text-base font-semibold text-[#2A1420]">
              {t.servicesSection.pricingNotice}
            </h4>
          </div>
          <p class="text-xs sm:text-sm text-[#524245] leading-relaxed">
            {t.servicesSection.customQuoteNote} {t.common.travelQualifierFull}
          </p>
        </div>

        <div class="shrink-0 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-[#4B1728] bg-[#F2E5E2] px-3.5 py-2 rounded-[4px] border border-[#DFC8C2]">
          <CheckCircle2 className="w-4 h-4 text-[#B99561] shrink-0" aria-hidden="true" />
          <span>{t.common.bhiwandiBase}</span>
        </div>
      </div>
    </div>

  </div>
</section>
