---
import { getTranslations, type Locale } from '../../utils/i18n';
import business, { buildWhatsAppUrl } from '../../utils/business';
import { 
  MapPin, 
  Sparkles, 
  CheckCircle2, 
  ShieldCheck, 
  Info, 
  Compass, 
  Phone
} from 'lucide-react';
import { WhatsAppIcon } from '../ui/Icons';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const currentLang = (lang as Locale) || 'en';
const t = getTranslations(currentLang);
const travelWhatsAppHref = buildWhatsAppUrl(
  business.contact.rawPhone, 
  t.serviceArea.outsideBhiwandiWhatsAppMessage
);
---

<section
  id="service-area"
  aria-labelledby="service-area-title"
  class="relative overflow-hidden bg-[#FBF8F4] py-10 sm:py-14 lg:py-20 border-b border-[#DFC8C2]/70 section-anchor scroll-mt-5 sm:scroll-mt-8 lg:scroll-mt-0"
>
  <!-- Ambient Editorial Background Gradients -->
  <div
    class="pointer-events-none absolute top-10 -left-32 w-80 h-80 rounded-full bg-[#F2E5E2]/60 blur-3xl"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute bottom-10 -right-32 w-80 h-80 rounded-full bg-[#B99561]/10 blur-3xl"
    aria-hidden="true"
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="max-w-3xl mb-8 sm:mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-[4px] bg-[#F2E5E2] border border-[#DFC8C2] text-[#4B1728] text-xs font-medium tracking-wide mb-4 shadow-xs">
        <MapPin className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
        <span>{t.serviceArea.eyebrow}</span>
      </div>

      <h2
        id="service-area-title"
        class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-[#2A1420] leading-[1.18] text-balance mb-4"
      >
        {t.serviceArea.heading}
      </h2>

      <p class="text-base sm:text-lg text-[#524245] leading-relaxed font-normal">
        {t.serviceArea.subheadline}
      </p>
    </div>

    <!-- 2-Column Editorial Architecture -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-stretch">
      
      <!-- ===================================================================
           Left Column: Base Location & Travel Evaluation Framework (7 Cols)
           =================================================================== -->
      <div class="lg:col-span-7 flex flex-col space-y-6 justify-between">
        
        <!-- Base Location Card -->
        <div class="p-6 sm:p-7 rounded-[6px] bg-white border border-[#DFC8C2] shadow-xs space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[#DFC8C2]/70 pb-3">
            <div class="flex items-center gap-2 text-[#4B1728]">
              <MapPin className="w-4 h-4 text-[#B99561] shrink-0" aria-hidden="true" />
              <h3 class="font-serif text-lg sm:text-xl font-medium text-[#2A1420]">
                {t.serviceArea.baseCardTitle}
              </h3>
            </div>
            <span class="inline-flex items-center px-2.5 py-1 rounded-[3px] text-xs font-semibold uppercase tracking-wider bg-[#F2E5E2] text-[#4B1728] border border-[#DFC8C2] self-start sm:self-auto">
              {t.serviceArea.baseCardLocation}
            </span>
          </div>

          <p class="text-xs sm:text-sm text-[#524245] leading-relaxed">
            {t.serviceArea.baseCardDescription}
          </p>

          <div class="p-3 rounded-[4px] bg-[#FBF8F4] border border-[#DFC8C2] flex items-start gap-2.5 text-xs text-[#524245]">
            <ShieldCheck className="w-4 h-4 text-[#B99561] shrink-0 mt-0.5" aria-hidden="true" />
            <span class="leading-relaxed">{t.serviceArea.baseCardNote}</span>
          </div>
        </div>

        <!-- Travel Evaluation Criteria Card -->
        <div class="p-6 sm:p-7 rounded-[6px] bg-white border border-[#DFC8C2] shadow-xs space-y-4 flex-1 flex flex-col justify-between">
          <div class="space-y-3">
            <div class="flex items-center gap-2 text-[#4B1728] border-b border-[#DFC8C2]/70 pb-3">
              <Compass className="w-4 h-4 text-[#B99561] shrink-0" aria-hidden="true" />
              <h3 class="font-serif text-lg sm:text-xl font-medium text-[#2A1420]">
                {t.serviceArea.travelCriteriaTitle}
              </h3>
            </div>

            <p class="text-xs sm:text-sm text-[#524245] leading-relaxed">
              {t.serviceArea.travelCardDescription}
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1">
              {t.serviceArea.travelCriteriaItems.map((item) => (
                <div class="flex items-start gap-2 p-2.5 rounded-[4px] bg-[#FBF8F4] border border-[#DFC8C2]/70 text-xs text-[#24191B]">
                  <CheckCircle2 className="w-3.5 h-3.5 text-[#B99561] shrink-0 mt-0.5" aria-hidden="true" />
                  <span class="leading-snug">{item}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Availability Condition Disclaimer -->
          <div class="pt-3 border-t border-[#DFC8C2]/70 flex items-start gap-2 text-xs text-[#74686A]">
            <Info className="w-3.5 h-3.5 text-[#B99561] shrink-0 mt-0.5" aria-hidden="true" />
            <span class="leading-relaxed">{t.serviceArea.travelCardCondition}</span>
          </div>
        </div>

      </div>

      <!-- ===================================================================
           Right Column: Travel Enquiry CTA & Editorial Composition (5 Cols)
           =================================================================== -->
      <div class="lg:col-span-5 flex flex-col h-full">
        <div class="h-full p-6 sm:p-8 rounded-[6px] bg-[#2A1420] text-[#FBF8F4] border-2 border-[#B99561]/60 shadow-xl flex flex-col justify-between relative overflow-hidden group">
          
          <!-- Subtle Decorative Luxury Corner Accents -->
          <div 
            class="pointer-events-none absolute -top-12 -right-12 w-48 h-48 rounded-full bg-[#B99561]/15 blur-2xl" 
            aria-hidden="true" 
          />
          <div 
            class="pointer-events-none absolute -bottom-12 -left-12 w-48 h-48 rounded-full bg-[#4B1728]/40 blur-2xl" 
            aria-hidden="true" 
          />

          <!-- Card Content -->
          <div class="relative z-10 space-y-4">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-[3px] bg-[#B99561]/20 border border-[#B99561]/40 text-[#D4B98E] text-[10px] uppercase font-semibold tracking-wider">
              <Sparkles className="w-3 h-3 text-[#B99561]" aria-hidden="true" />
              <span>{t.serviceArea.travelCardSubtitle}</span>
            </div>

            <h3 class="font-serif text-2xl sm:text-3xl font-medium text-[#FBF8F4] leading-tight">
              {t.serviceArea.outsideBhiwandiTitle}
            </h3>

            <p class="text-xs sm:text-sm text-[#DFC8C2] leading-relaxed">
              {t.serviceArea.outsideBhiwandiDescription}
            </p>

            <!-- Verified Guidelines List -->
            <div class="pt-2 pb-2 space-y-2 text-xs text-[#DFC8C2]">
              <div class="flex items-center gap-2">
                <CheckCircle2 className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
                <span>{t.common.onLocationService}</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
                <span>{t.common.enquiryBasedPricing}</span>
              </div>
              <div class="flex items-center gap-2">
                <CheckCircle2 className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
                <span>{business.location.displayLocation}</span>
              </div>
            </div>
          </div>

          <!-- WhatsApp Travel Enquiry Button & Fallback -->
          <div class="relative z-10 pt-6 mt-6 border-t border-[#3D1F30] space-y-3">
            <a
              href={travelWhatsAppHref}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center font-medium transition-all duration-200 cursor-pointer select-none rounded-[4px] bg-[#B99561] text-[#2A1420] hover:bg-[#D4B98E] active:bg-[#977643] text-xs sm:text-sm px-6 py-3.5 gap-2.5 uppercase tracking-wider font-semibold shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FBF8F4] focus-visible:ring-offset-2 focus-visible:ring-offset-[#2A1420] text-center"
            >
              <WhatsAppIcon className="w-5 h-5 shrink-0" aria-hidden="true" />
              <span>{t.serviceArea.outsideBhiwandiCta}</span>
            </a>

            <div class="flex items-center justify-between text-[11px] text-[#DFC8C2]/80 pt-1">
              <span>{business.contact.displayPhone}</span>
              <a 
                href={business.contact.directPhoneTel} 
                class="inline-flex items-center gap-1 hover:text-[#D4B98E] transition-colors underline underline-offset-2"
              >
                <Phone className="w-3 h-3 text-[#B99561]" aria-hidden="true" />
                <span>{t.footer.callNow}</span>
              </a>
            </div>
          </div>

        </div>
      </div>

    </div>

  </div>
</section>
