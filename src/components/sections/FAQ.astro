---
import { getTranslations, type Locale } from '../../utils/i18n';
import business, { buildWhatsAppUrl } from '../../utils/business';
import { FaqAccordion } from '../ui/FaqAccordion';
import { HelpCircle } from 'lucide-react';
import { WhatsAppIcon } from '../ui/Icons';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const currentLang = (lang as Locale) || 'en';
const t = getTranslations(currentLang);

const whatsAppUrl = buildWhatsAppUrl(
  business.contact.rawPhone,
  t.faqSection.bottomCta.whatsAppMessage
);
---

<section
  id="faq"
  aria-labelledby="faq-title"
  class="relative overflow-hidden bg-[#F2E5E2]/35 py-16 sm:py-20 lg:py-28 border-b border-[#DFC8C2]/70 section-anchor scroll-mt-5 sm:scroll-mt-8 lg:scroll-mt-0"
>
  <!-- Ambient Soft Blurs -->
  <div
    class="pointer-events-none absolute top-1/4 -left-32 w-80 h-80 rounded-full bg-[#B99561]/10 blur-3xl"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute bottom-1/4 -right-32 w-80 h-80 rounded-full bg-[#4B1728]/5 blur-3xl"
    aria-hidden="true"
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-12 sm:space-y-16">
    
    <!-- Section Header -->
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-[4px] bg-[#F2E5E2] border border-[#DFC8C2] text-[#4B1728] text-xs font-medium tracking-wide mb-4 shadow-xs">
        <HelpCircle className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
        <span>{t.faqSection.eyebrow}</span>
      </div>

      <h2
        id="faq-title"
        class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-[#2A1420] leading-[1.18] text-balance mb-4"
      >
        {t.faqSection.heading}
      </h2>

      <p class="text-base sm:text-lg text-[#524245] leading-relaxed font-normal">
        {t.faqSection.subheadline}
      </p>
    </div>

    <!-- Accessible FAQ Accordion Island -->
    <div>
      <FaqAccordion client:load items={t.faqSection.items} />
    </div>

    <!-- Bottom Question / Direct WhatsApp Enquiry Box -->
    <div class="max-w-4xl mx-auto p-6 sm:p-8 rounded-[8px] bg-white border border-[#DFC8C2] shadow-xs flex flex-col sm:flex-row items-center justify-between gap-6 text-center sm:text-left">
      <div class="space-y-1 max-w-xl">
        <h3 class="font-serif text-lg sm:text-xl font-medium text-[#2A1420]">
          {t.faqSection.bottomCta.title}
        </h3>
        <p class="text-xs sm:text-sm text-[#524245] leading-relaxed">
          {t.faqSection.bottomCta.description}
        </p>
      </div>

      <a
        href={whatsAppUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="w-full sm:w-auto shrink-0 inline-flex items-center justify-center gap-2 px-5 py-3 rounded-[4px] bg-[#4B1728] hover:bg-[#642037] text-[#FBF8F4] text-xs sm:text-sm font-semibold transition-all duration-200 shadow-xs hover:shadow-md focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B99561]"
      >
        <WhatsAppIcon className="w-5 h-5 shrink-0" aria-hidden="true" />
        <span>{t.faqSection.bottomCta.buttonText}</span>
      </a>
    </div>

  </div>
</section>
