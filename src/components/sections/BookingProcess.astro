---
import { getTranslations, type Locale } from '../../utils/i18n';
import business, { buildWhatsAppUrl } from '../../utils/business';
import { 
  Calendar, 
  Sparkles, 
  ShieldCheck, 
  CheckCircle2, 
  Info 
} from 'lucide-react';
import { WhatsAppIcon } from '../ui/Icons';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const currentLang = (lang as Locale) || 'en';
const t = getTranslations(currentLang);
const whatsAppHref = buildWhatsAppUrl(business.contact.rawPhone, t.bookingProcess.whatsAppMessage);
---

<section
  id="booking-process"
  aria-labelledby="booking-process-title"
  class="relative overflow-hidden bg-white py-16 sm:py-20 lg:py-28 border-b border-[#DFC8C2]/70 section-anchor scroll-mt-5 sm:scroll-mt-8 lg:scroll-mt-0"
>
  <!-- Dedicated anchor target for #process links aligned to section top without duplicate offset -->
  <span id="process" class="absolute top-0 left-0 section-anchor scroll-mt-5 sm:scroll-mt-8 lg:scroll-mt-0" aria-hidden="true"></span>

  <!-- Ambient Editorial Background Gradients -->
  <div
    class="pointer-events-none absolute top-12 -right-40 w-96 h-96 rounded-full bg-[#F2E5E2]/40 blur-3xl"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute bottom-12 -left-40 w-96 h-96 rounded-full bg-[#B99561]/8 blur-3xl"
    aria-hidden="true"
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header (Editorial & Centered/Aligned) -->
    <div class="max-w-3xl mb-12 sm:mb-16">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-[4px] bg-[#F2E5E2] border border-[#DFC8C2] text-[#4B1728] text-xs font-medium tracking-wide mb-4 shadow-xs">
        <Sparkles className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
        <span>{t.bookingProcess.eyebrow}</span>
      </div>

      <!-- 
        <h2
          id="booking-process-title"
          class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-[#2A1420] leading-[1.18] text-balance mb-4"
        >
          {t.bookingProcess.heading}
        </h2>

        <p class="text-base sm:text-lg text-[#524245] leading-relaxed font-normal">
          {t.bookingProcess.subheadline}
        </p>
      -->
    </div>

    <!-- 4-Step Connected Sequence Grid -->
    <div class="relative" style="display:none">
      <!-- Desktop Connecting Horizontal Guide Line -->
      <div
        class="hidden lg:block absolute top-10 left-16 right-16 h-px bg-[#DFC8C2] z-0"
        aria-hidden="true"
      />

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-6 lg:gap-7 relative z-10 items-stretch">
        
        <!-- Step 1: Enquiry -->
        <article class="flex flex-col h-full bg-[#FBF8F4] rounded-[6px] border border-[#DFC8C2] p-5 sm:p-6 shadow-xs hover:border-[#B99561]/60 transition-all duration-300 group">
          <div class="flex items-center justify-between mb-4">
            <div class="w-11 h-11 rounded-full bg-[#4B1728] text-[#FBF8F4] font-serif font-semibold text-sm flex items-center justify-center border-2 border-[#B99561] shadow-xs shrink-0 group-hover:scale-105 transition-transform">
              01
            </div>
            <span class="text-[10px] uppercase font-semibold tracking-wider text-[#4B1728] bg-[#F2E5E2] px-2.5 py-0.5 rounded border border-[#DFC8C2]">
              {t.bookingProcess.steps.step1.stepNumber}
            </span>
          </div>

          <h3 class="font-serif text-xl font-medium text-[#2A1420] mb-2 group-hover:text-[#4B1728] transition-colors">
            {t.bookingProcess.steps.step1.title}
          </h3>

          <p class="text-xs sm:text-sm text-[#524245] leading-relaxed mb-4 flex-1">
            {t.bookingProcess.steps.step1.description}
          </p>

          <div class="pt-3 border-t border-[#DFC8C2]/70 space-y-1.5 text-xs text-[#524245]">
            {t.bookingProcess.steps.step1.details.map((detail) => (
              <div class="flex items-start gap-1.5">
                <CheckCircle2 className="w-3.5 h-3.5 text-[#B99561] shrink-0 mt-0.5" aria-hidden="true" />
                <span class="text-[11px] leading-tight text-[#24191B]">{detail}</span>
              </div>
            ))}
          </div>
        </article>

        <!-- Step 2: Date & Location Check -->
        <article class="flex flex-col h-full bg-[#FBF8F4] rounded-[6px] border border-[#DFC8C2] p-5 sm:p-6 shadow-xs hover:border-[#B99561]/60 transition-all duration-300 group">
          <div class="flex items-center justify-between mb-4">
            <div class="w-11 h-11 rounded-full bg-[#4B1728] text-[#FBF8F4] font-serif font-semibold text-sm flex items-center justify-center border-2 border-[#B99561] shadow-xs shrink-0 group-hover:scale-105 transition-transform">
              02
            </div>
            <span class="text-[10px] uppercase font-semibold tracking-wider text-[#4B1728] bg-[#F2E5E2] px-2.5 py-0.5 rounded border border-[#DFC8C2]">
              {t.bookingProcess.steps.step2.stepNumber}
            </span>
          </div>

          <h3 class="font-serif text-xl font-medium text-[#2A1420] mb-2 group-hover:text-[#4B1728] transition-colors">
            {t.bookingProcess.steps.step2.title}
          </h3>

          <p class="text-xs sm:text-sm text-[#524245] leading-relaxed mb-4 flex-1">
            {t.bookingProcess.steps.step2.description}
          </p>

          <div class="pt-3 border-t border-[#DFC8C2]/70 p-2.5 rounded-[4px] bg-white border border-[#DFC8C2]/80">
            <div class="flex items-start gap-1.5 text-[11px] text-[#524245] leading-snug">
              <Calendar className="w-3.5 h-3.5 text-[#B99561] shrink-0 mt-0.5" aria-hidden="true" />
              <span>{t.bookingProcess.steps.step2.note}</span>
            </div>
          </div>
        </article>

        <!-- Step 3: Consultation -->
        <article class="flex flex-col h-full bg-[#FBF8F4] rounded-[6px] border border-[#DFC8C2] p-5 sm:p-6 shadow-xs hover:border-[#B99561]/60 transition-all duration-300 group">
          <div class="flex items-center justify-between mb-4">
            <div class="w-11 h-11 rounded-full bg-[#4B1728] text-[#FBF8F4] font-serif font-semibold text-sm flex items-center justify-center border-2 border-[#B99561] shadow-xs shrink-0 group-hover:scale-105 transition-transform">
              03
            </div>
            <span class="text-[10px] uppercase font-semibold tracking-wider text-[#4B1728] bg-[#F2E5E2] px-2.5 py-0.5 rounded border border-[#DFC8C2]">
              {t.bookingProcess.steps.step3.stepNumber}
            </span>
          </div>

          <h3 class="font-serif text-xl font-medium text-[#2A1420] mb-2 group-hover:text-[#4B1728] transition-colors">
            {t.bookingProcess.steps.step3.title}
          </h3>

          <p class="text-xs sm:text-sm text-[#524245] leading-relaxed mb-4 flex-1">
            {t.bookingProcess.steps.step3.description}
          </p>

          <div class="pt-3 border-t border-[#DFC8C2]/70 p-2.5 rounded-[4px] bg-white border border-[#DFC8C2]/80">
            <div class="flex items-start gap-1.5 text-[11px] text-[#524245] leading-snug">
              <Sparkles className="w-3.5 h-3.5 text-[#B99561] shrink-0 mt-0.5" aria-hidden="true" />
              <span>{t.bookingProcess.steps.step3.note}</span>
            </div>
          </div>
        </article>

        <!-- Step 4: Confirmation -->
        <article class="flex flex-col h-full bg-[#FBF8F4] rounded-[6px] border border-[#DFC8C2] p-5 sm:p-6 shadow-xs hover:border-[#B99561]/60 transition-all duration-300 group">
          <div class="flex items-center justify-between mb-4">
            <div class="w-11 h-11 rounded-full bg-[#4B1728] text-[#FBF8F4] font-serif font-semibold text-sm flex items-center justify-center border-2 border-[#B99561] shadow-xs shrink-0 group-hover:scale-105 transition-transform">
              04
            </div>
            <span class="text-[10px] uppercase font-semibold tracking-wider text-[#4B1728] bg-[#F2E5E2] px-2.5 py-0.5 rounded border border-[#DFC8C2]">
              {t.bookingProcess.steps.step4.stepNumber}
            </span>
          </div>

          <h3 class="font-serif text-xl font-medium text-[#2A1420] mb-2 group-hover:text-[#4B1728] transition-colors">
            {t.bookingProcess.steps.step4.title}
          </h3>

          <p class="text-xs sm:text-sm text-[#524245] leading-relaxed mb-4 flex-1">
            {t.bookingProcess.steps.step4.description}
          </p>

          <div class="pt-3 border-t border-[#DFC8C2]/70 p-2.5 rounded-[4px] bg-[#F2E5E2] border border-[#DFC8C2]">
            <div class="flex items-start gap-1.5 text-[11px] font-medium text-[#4B1728] leading-snug">
              <ShieldCheck className="w-3.5 h-3.5 text-[#B99561] shrink-0 mt-0.5" aria-hidden="true" />
              <span>{t.bookingProcess.steps.step4.notice}</span>
            </div>
          </div>
        </article>

      </div>
    </div>

    <!-- Booking Process Action & Disclaimer Banner -->
    <div class="mt-12 sm:mt-16 p-6 sm:p-8 rounded-[6px] bg-[#FBF8F4] border border-[#DFC8C2] shadow-xs">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
        <div class="space-y-2 max-w-2xl">
          <h3 class="font-serif text-xl sm:text-2xl font-medium text-[#2A1420]">
            {t.bookingProcess.ctaTitle}
          </h3>
          <p class="text-xs sm:text-sm text-[#524245] leading-relaxed">
            {t.bookingProcess.ctaDescription}
          </p>
          <div class="flex items-center gap-2 pt-1 text-xs text-[#74686A]">
            <Info className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
            <span>{t.bookingProcess.disclaimerNotice}</span>
          </div>
        </div>

        <a
          href={whatsAppHref}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center font-medium transition-all duration-200 cursor-pointer select-none rounded-[4px] bg-[#4B1728] text-[#FBF8F4] hover:bg-[#642037] active:bg-[#37101D] text-xs sm:text-sm px-6 py-3.5 gap-2.5 uppercase tracking-wider font-semibold shadow-xs focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B99561] focus-visible:ring-offset-2 shrink-0 text-center"
        >
          <WhatsAppIcon className="w-5 h-5 shrink-0" aria-hidden="true" />
          <span>{t.bookingProcess.ctaButton}</span>
        </a>
      </div>
    </div>

  </div>
</section>
