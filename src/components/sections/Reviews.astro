---
import { getTranslations, type Locale } from '../../utils/i18n';
import business from '../../utils/business';
import { Sparkles, ShieldCheck, Scale, HeartHandshake, ExternalLink } from 'lucide-react';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const currentLang = (lang as Locale) || 'en';
const t = getTranslations(currentLang);
const googleUrl = business.reviews.googleBusinessUrl || 'https://share.google/LOT7Ne1J7AtzPkc54';
---

<section
  id="reviews"
  aria-labelledby="reviews-title"
  class="relative overflow-hidden bg-[#FBF8F4] py-16 sm:py-20 lg:py-28 border-b border-[#DFC8C2]/70 section-anchor scroll-mt-5 sm:scroll-mt-8 lg:scroll-mt-0"
>
  <!-- Ambient Background Gradients -->
  <div
    class="pointer-events-none absolute top-12 -right-40 w-96 h-96 rounded-full bg-[#F2E5E2]/60 blur-3xl"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute bottom-12 -left-40 w-96 h-96 rounded-full bg-[#B99561]/10 blur-3xl"
    aria-hidden="true"
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-12 sm:space-y-16">
    
    <!-- Section Header -->
    <div class="max-w-3xl">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-[4px] bg-[#F2E5E2] border border-[#DFC8C2] text-[#4B1728] text-xs font-medium tracking-wide mb-4 shadow-xs">
        <Sparkles className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
        <span>{t.reviewsSection.eyebrow}</span>
      </div>

      <h2
        id="reviews-title"
        class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-[#2A1420] leading-[1.18] text-balance mb-4"
      >
        {t.reviewsSection.heading}
      </h2>

      <p class="text-base sm:text-lg text-[#524245] leading-relaxed font-normal">
        {t.reviewsSection.subheadline}
      </p>
    </div>

    <!-- Trust Pillars Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 items-stretch">
      
      <!-- Pillar 1: Verified Feedback -->
      <div class="bg-white rounded-[6px] border border-[#DFC8C2] p-6 sm:p-7 shadow-xs hover:shadow-md transition-shadow duration-200 flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-full bg-[#F2E5E2] flex items-center justify-center text-[#4B1728]">
            <ShieldCheck className="w-5 h-5 text-[#4B1728]" aria-hidden="true" />
          </div>
          <h3 class="font-serif text-lg font-medium text-[#2A1420]">
            {t.reviewsSection.trustPillars.verifiedTitle}
          </h3>
          <p class="text-sm text-[#524245] leading-relaxed">
            {t.reviewsSection.trustPillars.verifiedDesc}
          </p>
        </div>
      </div>

      <!-- Pillar 2: Independent & Transparent -->
      <div class="bg-white rounded-[6px] border border-[#DFC8C2] p-6 sm:p-7 shadow-xs hover:shadow-md transition-shadow duration-200 flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-full bg-[#F2E5E2] flex items-center justify-center text-[#4B1728]">
            <Scale className="w-5 h-5 text-[#4B1728]" aria-hidden="true" />
          </div>
          <h3 class="font-serif text-lg font-medium text-[#2A1420]">
            {t.reviewsSection.trustPillars.transparentTitle}
          </h3>
          <p class="text-sm text-[#524245] leading-relaxed">
            {t.reviewsSection.trustPillars.transparentDesc}
          </p>
        </div>
      </div>

      <!-- Pillar 3: Real Occasions -->
      <div class="bg-white rounded-[6px] border border-[#DFC8C2] p-6 sm:p-7 shadow-xs hover:shadow-md transition-shadow duration-200 flex flex-col justify-between">
        <div class="space-y-3">
          <div class="w-10 h-10 rounded-full bg-[#F2E5E2] flex items-center justify-center text-[#4B1728]">
            <HeartHandshake className="w-5 h-5 text-[#4B1728]" aria-hidden="true" />
          </div>
          <h3 class="font-serif text-lg font-medium text-[#2A1420]">
            {t.reviewsSection.trustPillars.occasionsTitle}
          </h3>
          <p class="text-sm text-[#524245] leading-relaxed">
            {t.reviewsSection.trustPillars.occasionsDesc}
          </p>
        </div>
      </div>

    </div>

    <!-- Official Google Business Profile Feature Card -->
    <div class="p-8 sm:p-10 lg:p-12 rounded-[8px] bg-[#2A1420] text-[#FBF8F4] border-2 border-[#B99561]/60 shadow-xl relative overflow-hidden">
      <!-- Decorative Backdrop Glows -->
      <div 
        class="pointer-events-none absolute -top-24 -right-24 w-80 h-80 rounded-full bg-[#B99561]/15 blur-3xl" 
        aria-hidden="true" 
      />
      <div 
        class="pointer-events-none absolute -bottom-24 -left-24 w-80 h-80 rounded-full bg-[#4B1728]/50 blur-3xl" 
        aria-hidden="true" 
      />

      <div class="max-w-3xl mx-auto text-center space-y-6 relative z-10">
        
        <!-- Google Logo & Verified Badge -->
        <div class="inline-flex items-center gap-2.5 px-3.5 py-1.5 rounded-full bg-white/10 backdrop-blur-xs border border-[#B99561]/40 text-[#DFC8C2] text-xs font-medium">
          <!-- Google "G" SVG Emblem -->
          <svg class="w-4 h-4" viewBox="0 0 24 24" aria-hidden="true">
            <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" />
            <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" />
            <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" />
            <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.52 6.16-4.52z" />
          </svg>
          <span class="tracking-wide">{t.reviewsSection.actionCard.badge}</span>
        </div>

        <h3 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-medium text-[#FBF8F4] leading-tight">
          {t.reviewsSection.actionCard.heading}
        </h3>

        <p class="text-sm sm:text-base text-[#DFC8C2] leading-relaxed max-w-2xl mx-auto">
          {t.reviewsSection.actionCard.description}
        </p>

        <!-- CTA Action Button -->
        <div class="pt-2 flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href={googleUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-[4px] bg-[#B99561] hover:bg-[#C9A672] text-[#2A1420] text-sm sm:text-base font-semibold transition-all duration-200 shadow-md hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#FBF8F4] group"
          >
            <span>{t.reviewsSection.actionCard.readReviewsCta}</span>
            <ExternalLink className="w-4 h-4 text-[#2A1420] group-hover:translate-x-0.5 transition-transform" aria-hidden="true" />
          </a>
        </div>

        <p class="text-xs text-[#DFC8C2]/70">
          {t.reviewsSection.actionCard.note}
        </p>

      </div>
    </div>

    <!-- Authenticity & Compliance Notice -->
    <div class="text-center pt-2">
      <p class="text-xs text-[#74686A] max-w-2xl mx-auto leading-relaxed">
        {t.reviewsSection.complianceNotice}
      </p>
    </div>

  </div>
</section>
