---
import { getTranslations, type Locale } from '../../utils/i18n';
import { PortfolioGallery } from '../ui/PortfolioGallery';
import { PORTFOLIO_VIDEO } from '../../config/portfolio';
import { Sparkles, Film, CheckCircle2 } from 'lucide-react';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const currentLang = (lang as Locale) || 'en';
const t = getTranslations(currentLang);
---

<section
  id="portfolio"
  aria-labelledby="portfolio-title"
  class="relative overflow-hidden bg-[#FBF8F4] py-10 sm:py-14 lg:py-20 border-b border-[#DFC8C2]/70 section-anchor scroll-mt-5 sm:scroll-mt-8 lg:scroll-mt-0"
>
  <!-- Ambient Background Gradients -->
  <div
    class="pointer-events-none absolute top-12 -left-40 w-96 h-96 rounded-full bg-[#F2E5E2]/60 blur-3xl"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute bottom-12 -right-40 w-96 h-96 rounded-full bg-[#B99561]/10 blur-3xl"
    aria-hidden="true"
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 space-y-12 sm:space-y-16">
    
    <!-- ===================================================================
         1. Portfolio Header & Interactive Gallery
         =================================================================== -->
    <div>
      <div class="max-w-3xl mb-8 sm:mb-12">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-[4px] bg-[#F2E5E2] border border-[#DFC8C2] text-[#4B1728] text-xs font-medium tracking-wide mb-4 shadow-xs">
          <Sparkles className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
          <span>{t.portfolioSection.eyebrow}</span>
        </div>

        <h2
          id="portfolio-title"
          class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-[#2A1420] leading-[1.18] text-balance mb-4"
        >
          {t.portfolioSection.heading}
        </h2>

        <p class="text-base sm:text-lg text-[#524245] leading-relaxed font-normal">
          {t.portfolioSection.subheadline}
        </p>
      </div>

      <!-- Interactive Gallery with Category Filters & Accessible Lightbox Island -->
      <PortfolioGallery 
        client:load 
        translations={t.portfolioSection} 
      />
    </div>

    <!-- ===================================================================
         2. Video Viewer: Artistry in Motion Reel
         =================================================================== -->
    <div class="p-6 sm:p-10 lg:p-12 rounded-[8px] bg-[#2A1420] text-[#FBF8F4] border-2 border-[#B99561]/60 shadow-xl relative overflow-hidden">
      <!-- Decorative Backdrop Blurs -->
      <div 
        class="pointer-events-none absolute -top-20 -right-20 w-72 h-72 rounded-full bg-[#B99561]/15 blur-3xl" 
        aria-hidden="true" 
      />
      <div 
        class="pointer-events-none absolute -bottom-20 -left-20 w-72 h-72 rounded-full bg-[#4B1728]/50 blur-3xl" 
        aria-hidden="true" 
      />

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center relative z-10">
        
        <!-- Left: Editorial Narrative & Description (7 Cols) -->
        <div class="lg:col-span-7 space-y-4 text-left">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-[3px] bg-[#B99561]/20 border border-[#B99561]/40 text-[#D4B98E] text-[10px] uppercase font-semibold tracking-wider">
            <Film className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
            <span>{t.portfolioSection.video.eyebrow}</span>
          </div>

          <h3 class="font-serif text-2xl sm:text-3xl lg:text-4xl font-medium text-[#FBF8F4] leading-tight">
            {t.portfolioSection.video.heading}
          </h3>

          <p class="text-sm sm:text-base text-[#DFC8C2] leading-relaxed">
            {t.portfolioSection.video.subheadline}
          </p>

          <div class="pt-2 space-y-2 text-xs text-[#DFC8C2]">
            <div class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
              <span>{t.portfolioSection.video.badge}</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
              <span>{t.common.onLocationService}</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
              <span>{t.common.bhiwandiBase}</span>
            </div>
          </div>

          <div class="pt-4 border-t border-[#3D1F30] text-[11px] text-[#DFC8C2]/70 leading-relaxed">
            <p>{t.portfolioSection.video.note}</p>
          </div>
        </div>

        <!-- Right: 9:16 Portrait Video Player Container (5 Cols) -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative w-full max-w-[280px] sm:max-w-xs aspect-9/16 rounded-[8px] overflow-hidden border-2 border-[#B99561]/70 shadow-2xl bg-black">
            <video
              src={PORTFOLIO_VIDEO.videoSrc}
              poster={PORTFOLIO_VIDEO.posterSrc}
              controls
              playsinline
              preload="metadata"
              width={PORTFOLIO_VIDEO.width}
              height={PORTFOLIO_VIDEO.height}
              class="w-full h-full object-cover"
              aria-label={t.portfolioSection.video.heading}
            >
              Your browser does not support the video tag.
            </video>
          </div>
        </div>

      </div>
    </div>

  </div>
</section>
