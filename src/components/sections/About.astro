---
import { getTranslations, type Locale } from '../../utils/i18n';
import business, { buildWhatsAppUrl } from '../../utils/business';
import { CertificateLightbox } from '../ui/CertificateLightbox';
import { Sparkles, MapPin, Award, HeartHandshake, CheckCircle2 } from 'lucide-react';
import { WhatsAppIcon } from '../ui/Icons';

interface Props {
  lang: string;
}

const { lang } = Astro.props;
const currentLang = (lang as Locale) || 'en';
const t = getTranslations(currentLang);
const whatsAppHref = buildWhatsAppUrl(business.contact.rawPhone, t.about.enquiryMessage);
---

<section
  id="about"
  aria-labelledby="about-title"
  class="relative overflow-hidden bg-white py-10 sm:py-14 lg:py-20 border-b border-[#DFC8C2]/70 section-anchor scroll-mt-5 sm:scroll-mt-8 lg:scroll-mt-0"
>
  <!-- Ambient Editorial Background Gradients (Subtle & Restrained) -->
  <div
    class="pointer-events-none absolute top-12 -left-40 w-96 h-96 rounded-full bg-[#F2E5E2]/40 blur-3xl"
    aria-hidden="true"
  />
  <div
    class="pointer-events-none absolute bottom-12 -right-40 w-96 h-96 rounded-full bg-[#B99561]/8 blur-3xl"
    aria-hidden="true"
  />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header (Editorial & Centered/Aligned) -->
    <div class="max-w-3xl mb-8 sm:mb-12">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-[4px] bg-[#F2E5E2] border border-[#DFC8C2] text-[#4B1728] text-xs font-medium tracking-wide mb-4 shadow-xs">
        <Sparkles className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
        <span>{t.about.eyebrow}</span>
      </div>

      <h2
        id="about-title"
        class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium tracking-tight text-[#2A1420] leading-[1.18] text-balance mb-4"
      >
        {t.about.heading}
      </h2>

      <p class="text-base sm:text-lg text-[#524245] leading-relaxed font-normal">
        {t.about.leadText}
      </p>
    </div>

    <!-- Main Editorial Grid: Left Visual & Right Narrative -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      
      <!-- ===================================================================
           Left Column: Artist Portrait & Experience Highlights (5 Cols)
           =================================================================== -->
      <div class="lg:col-span-5 flex flex-col space-y-6">
        
        <!-- Portrait Container with Asymmetrical Matting Frame -->
        <div class="relative w-full max-w-md mx-auto lg:max-w-none">
          <!-- Offset Decorative Background Frame -->
          <div
            class="hidden sm:block absolute -inset-2 sm:-inset-2.5 bg-[#F2E5E2] border border-[#DFC8C2] rounded-[4px] rotate-1 pointer-events-none shadow-xs"
            aria-hidden="true"
          />

          <!-- 4:5 Editorial Frame for Artist Visual -->
          <div class="relative rounded-[4px] overflow-hidden bg-[#2A1420] border-2 border-[#B99561]/50 shadow-xl aspect-5/7">
            <img
              src="/images/about/my_photo.jpeg"
              alt={t.about.portraitAlt}
              width="800"
              height="1000"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover object-top select-none"
            />

            <!-- Floating Artist Badge -->
            <div class="absolute inset-x-3 bottom-3 sm:inset-x-4 sm:bottom-4 p-2.5 sm:p-3 rounded-[4px] bg-[#2A1420]/90 backdrop-blur-sm border border-[#B99561]/60 text-left shadow-lg">
              <div class="flex items-center justify-between gap-2 border-b border-[#3D1F30] pb-1 mb-1">
                <span class="font-serif text-xs sm:text-sm font-medium text-[#FBF8F4] tracking-tight">
                  Amrapali
                </span>
                <span class="text-[9px] uppercase tracking-wider text-[#B99561] font-semibold">
                  {t.about.experienceBadge}
                </span>
              </div>
              <p class="text-[10px] text-[#DFC8C2] leading-tight">
                {t.about.experienceLabel} &bull; {business.location.displayLocation}
              </p>
            </div>
          </div>
        </div>

        <!-- Verified Credential Summary Card -->
        <div class="p-4 sm:p-5 rounded-[6px] bg-[#FBF8F4] border border-[#DFC8C2] shadow-xs space-y-3">
          <div class="flex items-start gap-3">
            <Award className="w-5 h-5 text-[#B99561] shrink-0 mt-0.5" aria-hidden="true" />
            <div class="space-y-1">
              <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold tracking-wider uppercase bg-[#B99561]/15 text-[#4B1728] border border-[#B99561]/30">
                {t.about.credentialsClassification}
              </span>
              <h3 class="font-serif text-sm font-semibold text-[#2A1420] leading-snug">
                {t.about.credentialsCourse}
              </h3>
              <p class="text-xs text-[#524245]">
                {t.about.credentialsDuration} &bull; {t.about.credentialsDate}
              </p>
            </div>
          </div>

          <p class="text-xs text-[#524245] leading-relaxed border-t border-[#DFC8C2]/70 pt-2.5">
            {t.about.credentialsDescription}
          </p>
        </div>

      </div>

      <!-- ===================================================================
           Right Column: Narrative, Approach & Interactive Certificate (7 Cols)
           =================================================================== -->
      <div class="lg:col-span-7 flex flex-col space-y-8 text-left">
        
        <!-- Story Prose -->
        <div class="space-y-4 text-sm sm:text-base text-[#524245] leading-relaxed">
          <p>
            {t.about.bioParagraph1}
          </p>
          <p>
            {t.about.bioParagraph2}
          </p>
        </div>

        <!-- Approach & Methodology Pillar Box -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-4 rounded-[6px] bg-[#FBF8F4] border border-[#DFC8C2] shadow-xs">
            <div class="flex items-center gap-2 mb-2 text-[#4B1728]">
              <HeartHandshake className="w-4 h-4 text-[#B99561] shrink-0" aria-hidden="true" />
              <h4 class="font-serif text-sm font-semibold text-[#2A1420]">
                {t.about.approachTitle}
              </h4>
            </div>
            <p class="text-xs text-[#524245] leading-relaxed">
              {t.about.approachDescription}
            </p>
          </div>

          <div class="p-4 rounded-[6px] bg-[#FBF8F4] border border-[#DFC8C2] shadow-xs">
            <div class="flex items-center gap-2 mb-2 text-[#4B1728]">
              <MapPin className="w-4 h-4 text-[#B99561] shrink-0" aria-hidden="true" />
              <h4 class="font-serif text-sm font-semibold text-[#2A1420]">
                {t.about.locationBadge}
              </h4>
            </div>
            <p class="text-xs text-[#524245] leading-relaxed">
              {t.about.locationQualifier}. {t.common.travelQualifierShort}.
            </p>
          </div>
        </div>

        <!-- Verified Training Certificate Display (Interactive Lightbox Island) -->
        <div class="space-y-3 pt-2">
          <div class="flex items-center justify-between gap-2">
            <h3 class="font-serif text-base sm:text-lg font-semibold text-[#2A1420]">
              {t.about.credentialsTitle}
            </h3>
            <span class="text-xs text-[#74686A]">
              1536 &times; 1024 Document
            </span>
          </div>

          <CertificateLightbox
            client:idle
            imageSrc="/images/about/amrapali-certificate.png"
            imageAlt={t.about.certificateAlt}
            triggerLabel={t.about.viewCertificate}
            closeLabel={t.about.closeCertificate}
            title={t.about.credentialsCourse}
            classification={t.about.credentialsClassification}
            description={t.about.credentialsDescription}
          />
        </div>

        <!-- Verified Value Checklist & WhatsApp CTA -->
        <div class="pt-4 border-t border-[#DFC8C2]/70 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
          <div class="space-y-1.5 text-xs text-[#524245]">
            <div class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
              <span class="font-medium text-[#24191B]">{t.common.onLocationService}</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 className="w-3.5 h-3.5 text-[#B99561] shrink-0" aria-hidden="true" />
              <span class="font-medium text-[#24191B]">{t.common.enquiryBasedPricing}</span>
            </div>
          </div>

          <!-- Direct WhatsApp Enquiry CTA -->
          <a
            href={whatsAppHref}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center font-medium transition-all duration-200 cursor-pointer select-none rounded-[4px] bg-[#4B1728] text-[#FBF8F4] border border-[#4B1728] hover:bg-[#642037] hover:border-[#642037] active:bg-[#37101D] shadow-[0_4px_14px_-2px_rgba(75,23,40,0.35)] text-xs sm:text-sm px-6 py-3 gap-2.5 uppercase tracking-wider font-semibold focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-[#B99561] focus-visible:ring-offset-2 shrink-0 text-center"
          >
            <WhatsAppIcon className="w-5 h-5 shrink-0" aria-hidden="true" />
            <span>{t.about.enquireCta}</span>
          </a>
        </div>

      </div>

    </div>

  </div>
</section>
