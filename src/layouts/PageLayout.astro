---
import BaseLayout from './BaseLayout.astro';
import AnnouncementStrip from '../components/layout/AnnouncementStrip.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { FloatingWhatsApp } from '../components/layout/FloatingWhatsApp';
import { getTranslations, type Locale } from '../utils/i18n';
import business from '../utils/business';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  isHomePage?: boolean;
}

const {
  title,
  description,
  lang = 'en',
  isHomePage = true,
} = Astro.props;

const currentLang = (lang as Locale) || 'en';
const t = getTranslations(currentLang);
const pageTitle = title || t.seo.metaTitle;
const pageDescription = description || t.seo.metaDescription;
const ogTitle = t.seo.ogTitle;
const ogDescription = t.seo.ogDescription;
const ogLocale = t.seo.ogLocale;
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  lang={currentLang}
  canonicalUrl={`${business.seo.siteUrl}/${currentLang}/`}
  ogTitle={ogTitle}
  ogDescription={ogDescription}
  ogLocale={ogLocale}
  hasLanguageAlternates={true}
  isHomePage={isHomePage}
>
  <!-- Top anchor for back-to-top navigation -->
  <div id="top" class="sr-only">Top of page</div>

  <!-- Accessible Skip to Content Link -->
  <a
    href="#main-content"
    class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:px-4 focus:py-2 focus:bg-[#4B1728] focus:text-[#FBF8F4] focus:rounded focus:outline-none focus:ring-2 focus:ring-[#B99561]"
  >
    Skip to main content
  </a>

  <!-- 1. Announcement Strip -->
  <AnnouncementStrip lang={currentLang} />

  <!-- 2. Responsive Global Header -->
  <Header lang={currentLang} />

  <!-- 3. Main Page Content Slot -->
  <main id="main-content" class="min-h-[60vh] focus:outline-none">
    <slot />
  </main>

  <!-- 4. Global Footer -->
  <Footer lang={currentLang} />

  <!-- 5. Floating WhatsApp Action -->
  <FloatingWhatsApp client:idle translations={t} business={business} />
</BaseLayout>
